{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "usaki-spike",
  "version": "0.0.0",
  "identifier": "dev.usaki.spike.hyprwindow",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "usaki",
        "width": 152,
        "height": 188,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
